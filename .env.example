# Optional LLM re-ranking API keys.
# Copy this file to ".env" and paste your key(s). The .env file is gitignored,
# so your secrets never get committed. You only need a key for the provider you
# pick in the UI — leave the others blank. With NO keys, the tool still works
# fully using the free built-in heuristic scorer.

# Google Gemini  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI / ChatGPT -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
